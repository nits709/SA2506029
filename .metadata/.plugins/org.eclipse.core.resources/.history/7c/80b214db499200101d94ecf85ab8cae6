package WebdriverDemos;

import java.util.List;

import org.openqa.selenium.By;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.interactions.Actions;

public class SA32_Action_Event_RightClick extends baseFunction {

	// click(); that is make a left click (default click of mouse)
	public static void main(String[] args) {

		//contextclick() - would make right click on element.
		
		launchBrowser("chrome");
		launchURL("https://demo.guru99.com/test/simple_context_menu.html");
		Actions act = new Actions(driver);

		WebElement rightClickOnElement = driver.findElement(By.xpath("//*[@id='authentication']/span"));
		
		// right click with 1st apporach
		
		//act.moveToElement(rightClickOnElement).contextClick().build().perform();
		
		// Right click with 2nd Approach.
		act.contextClick(rightClickOnElement).build().perform();
		

		List<WebElement>rightClickText = driver.findElements(By.xpath("//*[@id='authentication']/ul/li/span"));
		
		for(WebElement w: rightClickText) {
			System.out.println("get text from right click list --> "+ w.getText());
		}
		
		
		
		
		
		
		sleep();

		driver.close();

	}

}
