package Assignments;

import java.util.HashMap;
import java.util.List;
import java.util.Map;

import org.openqa.selenium.By;
import org.openqa.selenium.JavascriptExecutor;
import org.openqa.selenium.WebDriver;
org.openqa.selenium.devtools.Command;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.devtools.DevTools;
import org.openqa.selenium.devtools.HasDevTools;

import WebdriverDemos.baseFunction;

public class sample extends baseFunction {

	public static void main(String[] args) throws InterruptedException {
        WebDriver driver = new ChromeDriver();
        driver.manage().window().maximize();
        driver.get("https://demoqa.com/browser-windows");

        // Open DevTools session
        DevTools devTools = ((HasDevTools) driver).getDevTools();
        devTools.createSession();

        // Click "New Window Message"
        driver.findElement(By.id("messageWindowButton")).click();
        Thread.sleep(1000);

        // List all targets (tabs/windows)
        List<Map<String, Object>> targets =
                devTools.send(new Command<>("Target.getTargets", new HashMap<>()));
        		
        for (Map<String, Object> target : targets) {
            String url = (String) target.get("url");
            String type = (String) target.get("type");
            System.out.println("Target: " + url + " | Type: " + type);
        }

        // Switch to the about:blank window if visible
        for (String handle : driver.getWindowHandles()) {
            driver.switchTo().window(handle);
            String currentUrl = driver.getCurrentUrl();
            if (currentUrl.equals("about:blank")) {
                String message = (String) ((JavascriptExecutor) driver)
                        .executeScript("return document.body.textContent.trim();");
                System.out.println("✅ Captured Message: " + message);
            }
        }

        driver.quit();
    }
}
