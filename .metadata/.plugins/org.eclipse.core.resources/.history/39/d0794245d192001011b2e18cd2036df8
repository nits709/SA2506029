package Assignments;

import java.time.Duration;
import java.util.Set;

import org.openqa.selenium.By;
import org.openqa.selenium.JavascriptExecutor;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.support.ui.ExpectedCondition;
import org.openqa.selenium.support.ui.WebDriverWait;

import WebdriverDemos.baseFunction;

public class sample extends baseFunction {

	public static void main(String[] args) {
        WebDriver driver = new ChromeDriver();
        driver.manage().window().maximize();
        driver.get("https://demoqa.com/browser-windows");

        String mainWindow = driver.getWindowHandle();

        // Click the Message Window button
        driver.findElement(By.id("messageWindowButton")).click();

        // Wait until a second window is open
        WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(10));
        wait.until((ExpectedCondition<Boolean>) d -> d.getWindowHandles().size() > 1);

        // Switch to the new window
        Set<String> allWindows = driver.getWindowHandles();
        for (String win : allWindows) {
            if (!win.equals(mainWindow)) {
                driver.switchTo().window(win);

                // Wait until body exists and has text
                String message = wait.until((ExpectedCondition<String>) d -> {
                    Object text = ((JavascriptExecutor) d).executeScript(
                            "return document.body ? document.body.textContent.trim() : '';");
                    return text != null && !text.toString().isEmpty() ? text.toString() : null;
                });

                System.out.println("Captured Message: " + message);

                driver.close(); // Close child window
            }
        }

        // Switch back to main window
        driver.switchTo().window(mainWindow);
        driver.quit();
    }


}
