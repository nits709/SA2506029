import org.openqa.selenium.WebDriver;
import org.openqa.selenium.chrome.ChromeDriver;

import java.lang.reflect.Method;
import java.util.Arrays;
import java.util.TreeSet;

public class MethodCheck {
    public static void main(String[] args) {
        // Collect all methods from WebDriver (interface)
        Method[] webDriverMethods = WebDriver.class.getMethods();
        TreeSet<String> webDriverSet = new TreeSet<>();
        Arrays.stream(webDriverMethods).forEach(m -> webDriverSet.add(m.getName()));

        // Collect all methods from ChromeDriver (class)
        Method[] chromeDriverMethods = ChromeDriver.class.getMethods();
        TreeSet<String> chromeDriverSet = new TreeSet<>();
        Arrays.stream(chromeDriverMethods).forEach(m -> chromeDriverSet.add(m.getName()));

        // Print WebDriver methods
        System.out.println("=== Methods accessible via WebDriver reference ===");
        webDriverSet.forEach(System.out::println);

        // Print ChromeDriver methods
        System.out.println("\n=== Methods accessible via ChromeDriver reference ===");
        chromeDriverSet.forEach(System.out::println);

        // Find ChromeDriver-specific methods
        TreeSet<String> extraMethods = new TreeSet<>(chromeDriverSet);
        extraMethods.removeAll(webDriverSet);

        System.out.println("\n=== Extra methods in ChromeDriver (not in WebDriver) ===");
        extraMethods.forEach(System.out::println);
    }
}
