package Assignments;

import java.util.Iterator;
import java.util.Set;

import org.openqa.selenium.By;

import WebdriverDemos.baseFunction;

public class A_06_WindowHandle extends baseFunction {

	public static void main(String[] args) throws InterruptedException {

		launchBrowser("chrome");
		launchURL("https://omayo.blogspot.com/");

		// Click on MNC link
		driver.findElement(By.id("selenium143")).click();

		// Store the main window handle
		//String mainWindow = driver.getWindowHandle();

		Set<String> windows = driver.getWindowHandles(); // would return the id of all opened tab or window during
															// single session 
		Iterator<String> it = windows.iterator();
		String mainWindowID = it.next(); 
		String childWindowID = it.next(); 
		
		System.out.println("mainWindowID "+ mainWindowID + " : " + "childWindowID "+childWindowID);

			driver.switchTo().window(childWindowID);

		// Now you are in the first child window
		System.out.println("Child Window Title: " + driver.getTitle());

		// Perform click inside the child window
		driver.findElement(By.xpath("//*[@id='HTML4']/div[1]/table/tbody/tr/td[2]/a/img")).click();

		// Wait for new window to open
		Thread.sleep(5000);

		Set<String> ChildWindowId2 = driver.getWindowHandles();
		ChildWindowId2.removeAll(windows);
		String Child2 = ChildWindowId2.iterator().next();
		System.out.println("Child2 ID "+ Child2);
		//System.out.println("child 2 "+ ChildWindowId2.iterator().next());
		
		if(!Child2.equals(mainWindowID) && !Child2.equals(childWindowID)) {
			System.out.println("Inside ");
			driver.switchTo().window(Child2);
			System.out.println("Second Child Title: " + driver.getTitle());
		}
		

		// Now you are in the second child window
		

	}

}
