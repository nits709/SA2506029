package WebdriverDemos;

import java.util.List;

import org.openqa.selenium.By;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.interactions.Actions;

public class SA30_Action_Event_Mouse_Handling extends baseFunction {

	public static void main(String[] args) {
		launchBrowser("chrome");
		launchURL("https://www.istqb.in/");
		Actions act = new Actions(driver);

		WebElement linkSpec = driver.findElement(By.linkText("SPECIALIST"));
		act.moveToElement(linkSpec).build().perform();
		
		List<WebElement> noOfMenuList = driver.findElements(By.xpath("//nav[@role='navigation']/ul/li"));
		
		System.out.println("Total size "+ noOfMenuList.size());
		
		quitDriver();

	}
}
