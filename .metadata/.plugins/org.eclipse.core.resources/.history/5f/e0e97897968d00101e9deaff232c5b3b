package WebdriverDemos;

import java.util.List;

import org.openqa.selenium.By;
import org.openqa.selenium.WebElement;

public class SA23_HandlingWebTable extends baseFunction {

	public static void main(String[] args) {
		launchBrowser("chrome");
		launchURL("https://money.rediff.com/gainers/bse/daily/groupa");

		List<WebElement> tableHeaders = driver.findElements(By.cssSelector(".dataTable th"));
		System.out.println("Total no. of headers " + tableHeaders.size());

//			System.out.println("HeaderName of second column "+ tableHeaders.get(1).getText());
//			System.out.println("HeaderName of second column "+ tableHeaders.get(0).getText());

		for (WebElement headers : tableHeaders) {
			System.out.println("Tabel HeaderName " + headers.getText());
		}

		List<WebElement> rows = driver.findElements(By.xpath("//table[@class='dataTable']/tbody/tr"));
		System.out.println("Total no. of rows " + rows.size());

		System.out.println(" first company name -->"+ driver.findElement(By.xpath("//table[@class='dataTable']/tbody/tr[1]/td[1]/a")).getText();
		
		for (int i = 0; i < rows.size(); i++) {

		}

		driver.close();

	}

}
