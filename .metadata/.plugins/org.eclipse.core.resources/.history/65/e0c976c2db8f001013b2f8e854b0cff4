          // 5. Switch to child window
          driver.switchTo().window(childWindow);

          // 6. Extract text via JavaScript (works even if <body> not present)
          JavascriptExecutor js = (JavascriptExecutor) driver;
          String message = (String) js.executeScript("return document.documentElement.innerText;");

