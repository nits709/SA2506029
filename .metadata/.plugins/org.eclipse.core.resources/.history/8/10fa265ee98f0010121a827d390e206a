package Assignments;

import java.util.Iterator;
import java.util.Set;

import org.openqa.selenium.By;

import WebdriverDemos.baseFunction;

/*
 * Main WindowId 2BCCD7BF49E7E1AA97891C67B536F022 :
 * Child WindowId 6DE06C8D13404C6E7FE0FD4E154CFD3F
 */
public class A_21_MultipleWindow extends baseFunction {

	public static void main(String[] args) {
		launchBrowser("chrome");
		launchURL("https://omayo.blogspot.com/");

		driver.findElement(By.id("selenium143")).click();

		Set<String> window = driver.getWindowHandles();

		Iterator<String> windowHandles = window.iterator();
		String mainWindow = windowHandles.next();
		String childWindow = windowHandles.next();

		System.out.println("Main WindowId " + mainWindow + " : " + "Child WindowId " + childWindow);

		// driver.close();
		driver.quit();

	}

}
