package WebdriverDemos;

import java.time.Duration;

import org.openqa.selenium.By;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;

public class sample extends baseFunction {

	public static void main(String[] args) {

		launchBrowser("chrome");

		launchURL("https://www.redbus.in/");
		driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));

		driver.findElement(By.xpath("//*[@id='root']/div[2]/div/div[2]/div/div/div[1]/div[1]")).click();
		driver.findElement(By.id("srcDest")).sendKeys("Kolh");
		
FluentWait<WebDriver> wait = new FluentWait<WebDriver>(driver);
		
		// Source City
		driver.findElement(By.id("src")).sendKeys("Kolh");
		wait.withTimeout(Duration.ofSeconds(10)).ignoring(NoSuchElementException.class)
		.ignoring(StaleElementReferenceException.class)
		.pollingEvery(Duration.ofSeconds(2))
		.until(ExpectedConditions.visibilityOfElementLocated(By.xpath("/html/body/div[1]/div[2]/div/div[2]/div/div/div[1]/div[1]/div[1]/div[2]/div[4]/div[1]/div[5]/div[1]/div/div[1]"))).click();
//		driver.findElement(By.xpath(
//				"/html/body/div[1]/div[2]/div/div[2]/div/div/div[1]/div[1]/div[1]/div[2]/div[4]/div[1]/div[5]/div[1]/div/div[1]"))
//				.click();

		driver.findElement(By.xpath("//*[@id='root']/div[2]/div/div[2]/div/div/div[1]/div[2]")).click();
		driver.findElement(By.xpath("//input[@id='srcDest']")).sendKeys("Bhop");
		
		driver.findElement(By.xpath(
				"/html/body/div[1]/div[2]/div/div[2]/div/div/div[1]/div[2]/div[2]/div[4]/div[1]/div[3]/div[1]/div/div[1]"))
				.click();

		driver.findElement(By.xpath("//*[@id='root']/div[2]/div/div[2]/div/div/div[1]/div[3]/div[1]/i")).click();
		
		driver.findElement(By.xpath("//span[normalize-space()='10']")).click();

		driver.findElement(By.xpath("//*[@id='root']/div[2]/div/div[2]/div/button")).click();
		
		System.out.println(
				driver.findElement(By.xpath("//*[@id=\"40289231\"]/div[1]/div[3]/div/div[1]/div[1]")).getText());
		driver.close();
	}
}
