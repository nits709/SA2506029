package WebdriverDemos;

import java.util.Iterator;
import java.util.Set;

import org.openqa.selenium.By;

public class SA29_HandlingMultipleTab_Windows extends baseFunction {

	public static void main(String[] args) {
		
		launchBrowser("chrome");
		launchURL("https://www.naukri.com/");
		
		//clicks on MNC link
		driver.findElement(By.xpath("//*[@id='trending-naukri-wdgt']/div/div[1]/a[2]")).click();
		
		Set<String> windows = driver.getWindowHandles(); // would return the id  of all opened tab or window during single session
		Iterator<String> it =windows.iterator();
		
		String mainWindow = it.next(); // id of mainwindow
		String childWindow = it.next(); // id of childwindow
		
		
		
		driver.switchTo().window(childWindow);
		
		
		
		//capture MNC page Title
		System.out.println("Child Page Title " +driver.getTitle()); // child window
		
		
		
		//clicks on Login Slider element
		driver.findElement(By.xpath("//*[@id='login_Layer']")).click();  // child window
		
		
		driver.switchTo().window(mainWindow);
		
		
		System.out.println("page title of parent window -" + driver.getTitle());
		
		
		
		
		driver.quit(); // quit will close all opened window during single session.
		
		
		
		
		
		
		
		
		
		

	}

}
