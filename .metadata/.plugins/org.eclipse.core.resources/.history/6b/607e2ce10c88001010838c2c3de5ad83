package Assignments;

import org.openqa.selenium.WebDriver;
import org.openqa.selenium.chrome.ChromeDriver;

public class A_04_OrangeHRM_Login {

	public static void main(String[] args) {
		
		WebDriver dr = new ChromeDriver();
	    dr.get("https://opensource-demo.orangehrmlive.com/web/index.php/auth/login");
	    dr.manage().window().maximize();

	    dr.findElement(By.cssSelector("input[placeholder='Username']")).sendKeys("Admin");
	  dr.findElement(By.cssSelector("input[placeholder='Password']")).sendKeys("admin123");

	   
	    dr.findElement(By.cssSelector("button[type='submit']")).click();

	    // Option 2: Or hit Enter on password field
	    // dr.findElement(By.cssSelector("input[name*='password']")).sendKeys("admin123", Keys.ENTER);

	    Thread.sleep(5000);
	    dr.close();
	}
}
